#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@

override_dh_auto_build:
	$(MAKE) CC="$(CC)" CFLAGS="$(CFLAGS) $(CPPFLAGS)" LDFLAGS="$(LDFLAGS)"
	cmake -S gui -B build/gui -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=RelWithDebInfo
	cmake --build build/gui --parallel

override_dh_auto_install:
	install -Dm755 encoder debian/encoder/usr/bin/encoder
	DESTDIR="$(CURDIR)/debian/kencoder" cmake --install build/gui --prefix /usr

# Sort after the upstream 97-omen_encoder.rules if it was manually installed.
# This keeps the device from remaining world-writable.
override_dh_installudev:
	dh_installudev --priority=99

override_dh_auto_clean:
	$(MAKE) clean
	rm -rf build/gui
