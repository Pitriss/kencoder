#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@

override_dh_auto_build:
	$(MAKE) CC="$(CC)" CFLAGS="$(CFLAGS) $(CPPFLAGS)" LDFLAGS="$(LDFLAGS)"
	cmake -S gui -B build/gui -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=RelWithDebInfo -DKENCODER_REQUIRE_KCM=ON -DKENCODER_REQUIRE_TRANSLATIONS=ON
	cmake --build build/gui --parallel
	cmake -S notify -B build/notify -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=RelWithDebInfo
	cmake --build build/notify --parallel
	# dh_installman detects the language from encoder.<lang>.1 filenames.
	mkdir -p build/manpages
	for lang in en sk uk de ru pl; do \
		cp "docs/man/$$lang/man1/encoder.1" "build/manpages/encoder.$$lang.1"; \
	done

override_dh_auto_install:
	install -Dm755 build/cli/encoder debian/encoder/usr/bin/encoder
	DESTDIR="$(CURDIR)/debian/kencoder" cmake --install build/gui --prefix /usr
	DESTDIR="$(CURDIR)/debian/kencoder" cmake --install build/notify --prefix /usr

# Sort after the upstream 97-omen_encoder.rules if it was manually installed.
# This keeps the device from remaining world-writable.
override_dh_installudev:
	dh_installudev --priority=99

# The bundled KCM uses KF6 only inside its plugin. Do not pull its runtime
# dependencies into the ordinary Qt Widgets application package.
override_dh_shlibdeps:
	dh_shlibdeps -Xkcm_kencoder.so -Xkcm_kencoder_notify.so

override_dh_auto_clean:
	$(MAKE) clean
	rm -rf build/gui build/notify build/manpages
