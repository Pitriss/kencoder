Package: kencoder
Architecture: linux-any
Depends: encoder (>= 0.2.0), ${shlibs:Depends}, ${misc:Depends}, qt6-qpa-plugins, libkf6kcmutils6, qml6-module-org-kde-kcmutils, qml6-module-org-kde-kirigami
