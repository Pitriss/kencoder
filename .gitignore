# Local builds and Debian packaging output
# Keep the legacy upstream in-tree build artefacts ignored, if present.
/encoder
/*.o
/build/
/dist/
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/encoder/
/debian/kencoder/
/debian/*.substvars
/debian/*.debhelper.log
/.log/
/.tmp/
